# Copy to backend/.env and fill in. backend/.env is git-ignored — keep signed URLs out of the public repo.

# Organizers' GET endpoint (from the task PDF, "Открыть GET для DEV" button). group_id is replaced on import.
CQA_API_URL=

# Scoring providers (toggle in the UI). mock = keyword demo scorer, always available.
CQA_DEFAULT_PROVIDER=mock

# Cloud: OpenAI — paste your key to enable "Облако · OpenAI" (good for testing)
CQA_OPENAI_API_KEY=
CQA_OPENAI_MODEL=gpt-4.1-mini

# Cloud: Groq — paste your key to enable "Облако · Groq" (hosts Qwen3 too)
CQA_GROQ_API_KEY=
CQA_GROQ_MODEL=qwen/qwen3-32b

# Local: Qwen3 via Ollama (ollama pull qwen3:8b) or any OpenAI-compatible server
CQA_QWEN_BASE_URL=
CQA_QWEN_MODEL=qwen3:8b
CQA_QWEN_API_KEY=

# Cloud: Gemini — the ML team's slot (implement GeminiScorer._complete in backend/app/scorers/llm.py)
CQA_GEMINI_API_KEY=
CQA_GEMINI_MODEL=

# Parallel evaluations during batch runs (lower it if the provider rate-limits you)
CQA_CONCURRENCY=4


# Optional overrides
# CQA_DB_URL=postgresql+psycopg://user:pass@localhost/cqa
# CQA_DATA_DIR=./data
